## 
## Quickly get and  activation of this file:
# wget https://raw.githubusercontent.com/mattsn0w/dotfiles/refs/heads/main/.bashrc.extra -O ~/.bashrc.extra && echo 'if [ -f ~/.bashrc.extra ]; then source ~/.bashrc.extra ; fi' >> ~/.bashrc && echo '' >> ~/.bashrc


## History file setup
## See https://www.gnu.org/software/bash/manual/html_node/The-Shopt-Builtin.html
export HISTCONTROL=ignoreboth
export HISTFILE=~/.peekaboo
export HISTTIMEFORMAT="%h/%d - %H:%M:%S "
export HISTFILESIZE=100000

shopt -s histappend


## https://www.gnu.org/software/bash/manual/html_node/The-Shopt-Builtin.html
shopt -s checkwinsize
export TERM=xterm-color

### Must have fzf (shell fuzzy finder) - this is a game changer and must have! https://github.com/junegunn/fzf
### 
if [ $(which fzf) ]; then
  export FZF_DEFAULT_OPTS="--height=-50%"
  #
  # Theme for fzf - https://vitormv.github.io/fzf-themes/
  # COLORS
  export FZF_DEFAULT_OPTS=$FZF_DEFAULT_OPTS' --color=fg:#d0d0d0,fg+:#d0d0d0,bg:#121212,bg+:#262626 --color=hl:#5f87af,hl+:#5fd7ff,info:#afaf87,marker:#87ff00 --color=prompt:#d7005f,spinner:#af5fff,pointer:#af5fff,header:#87afaf --color=border:#262626,label:#aeaeae,query:#d9d9d9'
  # DECORATE BORDERS
  export FZF_DEFAULT_OPTS=$FZF_DEFAULT_OPTS' --border=rounded --border-label="fzf" --preview-window=border-rounded'
  # DECORATE PROMPT AND CURSOR
  export FZF_DEFAULT_OPTS=$FZF_DEFAULT_OPTS' --prompt="> "  --marker=">" --pointer="◆" --separator="─" --scrollbar="│"'
  # Execute
  eval "$(fzf --bash )"
fi


function kubernetes() {
# Settings for Kubernetes, kubectl, k9s
  alias k=kubectl
  complete -F __start_kubectl k
  export TERM=xterm-256color
  
  which kubectl > /dev/null 2>&1
  if [ $? -eq 0 ]; then
    source <(k completion bash)
  else
    echo "kubectl not found in \$PATH"
  fi
  
  K8S_CFGS=(
    "/etc/rancher/k3s/k3s.yaml"
    "/etc/rancher/rke2/rke2.yaml"
  )
  for file in ${K8S_CFGS[@]}; do
    if [ -f "${file}" ] ; then
      export KUBECONFIG=${file}
    fi
  done
  if [ -z "$KUBECONFIG" ]; then
    echo "No \$KUBECONFIG set. "
  fi
# END kubernetes()
}

#
## SSH Helpers
#
export WHOAMI=$(whoami)
function addsshkeyifnone() {
  retcode=$1
  if [ "$retcode" -ne 0 ]; then
    echo "Adding id_ed25519 key..."
    ssh-add ~/.ssh/id_ed25519
  elif [ "$retcode" -eq 0 ]; then
    echo "already have key in agent."
  fi
}

function sshagenthelper() {
  if pgrep -u ${WHOAMI} ssh-agent 2>&1 >/dev/null ; then 
     echo "ssh-agent already running with pid $(pgrep -u ${WHOAMI} ssh-agent ). sourcing ~/.ssh/agent.env." \
      && source ~/.ssh/agent.env 
      ssh-add -l 2>&1 > /dev/null
      addsshkeyifnone $?
  else 
     echo "ssh-agent not running. Starting a new one"
     ssh-agent > ~/.ssh/agent.env \
       && source ~/.ssh/agent.env
      ssh-add -l 2>&1 > /dev/null
      addsshkeyifnone $?
  fi
}

alias ssh='sshagenthelper && ssh -A'
alias scp='sshagenthelper && scp'

#
## END SSH Helper section.
#




## 
## Get Latest useful softwares
## 

function get-k9s() {
  ORG=derailed
  REPO=k9s
  mkdir app-dl-${REPO} && cd app-dl-${REPO}

  SHA_FILE=checksums.sha256
  DL_FILE=k9s_Linux_amd64.tar.gz
  SHA_FILE_DL_ONLY=checksums.sha256.${DL_FILE}
  GITHUB_URL=https://api.github.com/repos/${ORG}/${REPO}/releases/latest
  wget ${GITHUB_URL} -O ${REPO}.json

  VERSION=$( cat ${REPO}.json | jq -r '.tag_name' )
  SHA_URL=$( cat ${REPO}.json | jq -r '.assets.[].browser_download_url' | grep ${SHA_FILE} )
  DL_URL=$( cat ${REPO}.json | jq -r '.assets.[].browser_download_url' | egrep -i "${DL_FILE}\$" )

  wget ${DL_URL}
  wget ${SHA_URL}
  grep "${DL_FILE}\$" ${SHA_FILE} > ${SHA_FILE_DL_ONLY}
  sha256sum -c ${SHA_FILE_DL_ONLY}
  if [ $? -eq 0 ]; then
    echo "Sha256 matches OK. Installing ${REPO} ${VERSION} to /usr/local/bin/k9s..."
    tar -zxf ${DL_FILE}
    chmod +x k9s
    mv k9s /usr/local/bin/
    cd .. && rm -rf app-dl-${REPO}
  fi
}

function get-fzf() {
  ORG=junegunn
  REPO=fzf
  mkdir app-dl-${REPO} && cd app-dl-${REPO}

  GITHUB_URL=https://api.github.com/repos/${ORG}/${REPO}/releases/latest
  wget ${GITHUB_URL} -O ${REPO}.json

  VERSION=$( cat ${REPO}.json | jq -r '.name' )

  SHA_FILE=${REPO}_${VERSION}_checksums.txt
  DL_FILE=${REPO}-${VERSION}-linux_amd64.tar.gz
  SHA_FILE_DL_ONLY=${SHA_FILE}.${DL_FILE}

  SHA_URL=$( cat ${REPO}.json | jq -r '.assets.[].browser_download_url' | grep ${SHA_FILE} )
  DL_URL=$( cat ${REPO}.json | jq -r '.assets.[].browser_download_url' | egrep -i "${DL_FILE}\$" )

  wget ${DL_URL}
  wget ${SHA_URL}
  grep "${DL_FILE}\$" ${SHA_FILE} > ${SHA_FILE_DL_ONLY}
  sha256sum -c ${SHA_FILE_DL_ONLY}
  if [ $? -eq 0 ]; then
    echo "Sha256 matches OK. Installing ${REPO} ${VERSION} to /usr/local/bin/${REPO}..."
    tar -zxf ${DL_FILE}
    chmod +x ${REPO} && chown root:root ${REPO}
    mv ${REPO} /usr/local/bin/
    cd .. && rm -rf app-dl-${REPO}
  fi
}
