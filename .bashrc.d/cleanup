## 
## Get Latest useful softwares
## 

function get-k9s() {
  ORG=derailed
  REPO=k9s
  mkdir app-dl-${REPO} && cd app-dl-${REPO}

  SHA_FILE=checksums.sha256
  DL_FILE=k9s_Linux_amd64.tar.gz
  SHA_FILE_DL_ONLY=checksums.sha256.${DL_FILE}
  GITHUB_URL=https://api.github.com/repos/${ORG}/${REPO}/releases/latest
  wget ${GITHUB_URL} -O ${REPO}.json

  VERSION=$( cat ${REPO}.json | jq -r '.tag_name' )
  SHA_URL=$( cat ${REPO}.json | jq -r '.assets.[].browser_download_url' | grep ${SHA_FILE} )
  DL_URL=$( cat ${REPO}.json | jq -r '.assets.[].browser_download_url' | egrep -i "${DL_FILE}\$" )

  wget ${DL_URL}
  wget ${SHA_URL}
  grep "${DL_FILE}\$" ${SHA_FILE} > ${SHA_FILE_DL_ONLY}
  sha256sum -c ${SHA_FILE_DL_ONLY}
  if [ $? -eq 0 ]; then
    echo "Sha256 matches OK. Installing ${REPO} ${VERSION} to /usr/local/bin/k9s..."
    tar -zxf ${DL_FILE}
    chmod +x k9s
    mv k9s /usr/local/bin/
    cd .. && rm -rf app-dl-${REPO}
  fi
}

function get-fzf() {
  ORG=junegunn
  REPO=fzf
  mkdir app-dl-${REPO} && cd app-dl-${REPO}

  GITHUB_URL=https://api.github.com/repos/${ORG}/${REPO}/releases/latest
  wget ${GITHUB_URL} -O ${REPO}.json

  VERSION=$( cat ${REPO}.json | jq -r '.name' )

  SHA_FILE=${REPO}_${VERSION}_checksums.txt
  DL_FILE=${REPO}-${VERSION}-linux_amd64.tar.gz
  SHA_FILE_DL_ONLY=${SHA_FILE}.${DL_FILE}

  SHA_URL=$( cat ${REPO}.json | jq -r '.assets.[].browser_download_url' | grep ${SHA_FILE} )
  DL_URL=$( cat ${REPO}.json | jq -r '.assets.[].browser_download_url' | egrep -i "${DL_FILE}\$" )

  wget ${DL_URL}
  wget ${SHA_URL}
  grep "${DL_FILE}\$" ${SHA_FILE} > ${SHA_FILE_DL_ONLY}
  sha256sum -c ${SHA_FILE_DL_ONLY}
  if [ $? -eq 0 ]; then
    echo "Sha256 matches OK. Installing ${REPO} ${VERSION} to /usr/local/bin/${REPO}..."
    tar -zxf ${DL_FILE}
    chmod +x ${REPO} && chown root:root ${REPO}
    mv ${REPO} /usr/local/bin/
    cd .. && rm -rf app-dl-${REPO}
  fi
}
